# PostgreSQL. On Supabase: Project Settings → Database → Connection string.
# Pooled ("Transaction pooler", port 6543) for the app; add ?pgbouncer=true
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"
# Direct / session connection (port 5432) for migrations
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# Vercel's Supabase integration sets POSTGRES_PRISMA_URL / POSTGRES_URL_NON_POOLING instead; both work.

# One-time browser setup at /setup (closes itself after the first admin exists)
SETUP_TOKEN=""

# Public address of the app, no trailing slash (optional on Vercel: defaults to the project's domain)
APP_URL="http://localhost:3000"

# Optional: card payments in the shop. Without it, only "pay at club".
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Optional: emails via Resend (resend.com). Without it, emails are printed to the server log.
RESEND_API_KEY=""
EMAIL_FROM="ChessGo <noreply@yourdomain.com>"
